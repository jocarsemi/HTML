                    </div>

                </div>

                <div class="theory-layout">

                    <aside class="theory-sidebar">

                        <h3>CONTENIDO</h3>

                        <div id="theoryModuleNavigation">

                            <button class="theory-module-link active"
                                    data-module="1"
                                    type="button">
                                <span class="module-dot html-dot"></span>
                                01. HTML5
                            </button>

                            <button class="theory-module-link"
                                    data-module="2"
                                    type="button">
                                <span class="module-dot css-dot"></span>
                                02. CSS3
                            </button>

                            <button class="theory-module-link"
                                    data-module="3"
                                    type="button">
                                <span class="module-dot js-dot"></span>
                                03. JavaScript
                            </button>

                            <button class="theory-module-link"
                                    data-module="4"
                                    type="button">
                                <span class="module-dot dom-dot"></span>
                                04. DOM y eventos
