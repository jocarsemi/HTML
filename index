            <section class="view"
                     id="view-sandbox">

                <div class="page-heading">

                    <div>
                        <span class="section-eyebrow">DESARROLLO EN TIEMPO REAL</span>
                        <h2>Laboratorio de código</h2>

                        <p>
                            Escribe HTML, CSS y JavaScript y observa
                            cómo funciona tu código en el navegador.
                        </p>
                    </div>

                    <div class="lab-status">
                        <span class="status-dot"></span>
                        Entorno de desarrollo
                    </div>

                </div>


                <!-- PLANTILLAS -->

                <div class="template-toolbar">

                    <div>
                        <strong>Plantillas de ejercicios</strong>
                        <small>Comienza con un ejemplo preparado.</small>
                    </div>

                    <div class="template-buttons">

                        <button class="template-btn"
                                data-template="basic"
                                type="button">
                            Página básica
                        </button>

                        <button class="template-btn"
                                data-template="flexbox"
                                type="button">
                            Flexbox
                        </button>

                        <button class="template-btn"
                                data-template="grid"
                                type="button">
                            CSS Grid
                        </button>

                        <button class="template-btn"
                                data-template="javascript"
                                type="button">
                            JavaScript
                        </button>

                        <button class="template-btn"
                                data-template="dom"
                                type="button">
                            DOM
                        </button>

                    </div>

                </div>


                <!-- EDITOR -->

                <div class="editor-layout">

                    <div class="editor-panel">

                        <div class="editor-header">

                            <div class="editor-title">
                                <span class="editor-dot html-dot"></span>
                                <strong>index.html</strong>
                            </div>

                            <span class="editor-language">HTML5</span>

                        </div>

                        <textarea
                            id="htmlEditor"
                            class="code-editor"
                            spellcheck="false"
                            autocapitalize="off"
                            autocomplete="off"
                            aria-label="Editor HTML"
                            placeholder="Escribe aquí tu código HTML..."></textarea>

                    </div>


                    <div class="editor-panel">

                        <div class="editor-header">

                            <div class="editor-title">
                                <span class="editor-dot css-dot"></span>
                                <strong>styles.css</strong>
                            </div>

                            <span class="editor-language">CSS3</span>

                        </div>

                        <textarea
                            id="cssEditor"
                            class="code-editor"
                            spellcheck="false"
                            autocapitalize="off"
                            autocomplete="off"
                            aria-label="Editor CSS"
                            placeholder="Escribe aquí tu código CSS..."></textarea>

                    </div>


                    <div class="editor-panel">

                        <div class="editor-header">

                            <div class="editor-title">
                                <span class="editor-dot js-dot"></span>
                                <strong>script.js</strong>
                            </div>

                            <span class="editor-language">JavaScript ES6+</span>

                        </div>

                        <textarea
                            id="jsEditor"
                            class="code-editor"
                            spellcheck="false"
                            autocapitalize="off"
                            autocomplete="off"
                            aria-label="Editor JavaScript"
                            placeholder="Escribe aquí tu código JavaScript..."></textarea>

                    </div>

                </div>


                <!-- CONTROLES DEL EDITOR -->

                <div class="editor-controls">

                    <div class="editor-controls-left">

                        <button class="btn btn-primary"
                                id="runCode"
                                type="button">
                            ▶ Ejecutar código
                        </button>

                        <button class="btn btn-outline"
                                id="clearEditor"
                                type="button">
                            🗑 Limpiar
                        </button>

                    </div>

                    <div class="editor-controls-right">

                        <span class="editor-hint">
                            Ctrl + Enter para ejecutar
                        </span>

                        <span class="execution-status"
                              id="executionStatus">
                            Listo
                        </span>

                    </div>

                </div>


                <!-- VISTA PREVIA -->

                <div class="preview-panel">

                    <div class="preview-header">

                        <div class="preview-title">
                            <span class="preview-dot"></span>
                            <strong>Vista previa</strong>
                        </div>

                        <div class="preview-actions">

                            <span id="previewStatus">Esperando ejecución</span>

                            <button id="refreshPreview"
                                    class="icon-button"
                                    type="button"
                                    aria-label="Actualizar vista previa">
                                ↻
                            </button>

                        </div>

                    </div>

                    <iframe
                        id="previewFrame"
                        title="Vista previa del código del alumno"
                        sandbox="allow-scripts"
                        referrerpolicy="no-referrer">
                    </iframe>

                </div>


                <!-- CONSOLA -->

                <div class="console-panel">

                    <div class="console-header">

                        <strong>▸ Consola de salida</strong>

